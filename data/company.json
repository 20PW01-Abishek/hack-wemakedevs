  "decisions": [
    {
      "id": "DEC1",
      "summary": "Cut AE accelerator from 1.5x to 1.2x, effective Aug 15 2026",
      "date": "2026-08-12",
      "changed": "AE Accelerator",
      "proposed_by": 10,
      "approved_by": 1,
      "doc": "D1",
      "reason": "Q2 accelerator payouts ran 22% over budget. Impact model: saves ~INR 38L per quarter, top AEs lose ~12% of variable. Managers to brief their teams."
    },
    {
      "id": "DEC2",
      "summary": "Add +2% bonus for 3-year deals from Q3 2026",
      "date": "2026-07-08",
      "changed": "Multi-year Bonus",
      "proposed_by": 10,
      "approved_by": 1,
      "doc": "D2",
      "reason": "Customers keep asking for 3-year terms; reward AEs for multi-year deals. Paid upfront, 90-day clawback still applies."
    },
    {
      "id": "DEC3",
      "summary": "Raise SDR meeting bonus to INR 1500, qualified meetings only",
      "date": "2026-09-12",
      "changed": "SDR Meeting Bonus",
      "proposed_by": 10,
      "approved_by": 11,
      "doc": "D3",
      "reason": "Only meetings marked qualified by the AE count; bonus raised to offset excluding no-shows."
    },
    {
      "id": "DEC4",
      "summary": "Extend clawback window from 60 to 90 days for all plans",
      "date": "2026-06-18",
      "changed": "Clawback Window",
      "proposed_by": 12,
      "approved_by": 11,
      "doc": "D4",
      "reason": "4 churns happened at day 70-80 this half; a 60-day window missed them."
    }
  ]
